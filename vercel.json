{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/rss.xml", "destination": "/api/rss" },
    { "source": "/blog/:slug", "destination": "/api/yazi?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "crons": [{ "path": "/api/indexnow", "schedule": "10 21 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
