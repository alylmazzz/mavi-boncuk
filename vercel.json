{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog" },
    { "source": "/blog/rss.xml", "destination": "/api/rss" },
    { "source": "/blog/:slug", "destination": "/api/yazi?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/yonetim", "destination": "/api/yonetim" }
  ],
  "functions": {
    "api/yonetim.js": { "includeFiles": "api/_lib/panel/**" },
    "api/urunler.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/indexnow", "schedule": "10 21 * * *" },
    { "path": "/api/telegram?gunluk=1", "schedule": "0 6 * * *" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
